pkgname=tg-maid
pkgver=r436.b1efcfa
pkgrel=1
pkgdesc="My TG MAID"
url="https://github.com/Avimitin/tg-maid"
arch=('x86_64')
license=('MIT')
depends=('openssl' 'yt-dlp' 'ffmpeg' 'redis')
makedepends=('git' 'rust' 'mold' 'pkgconf' 'noto-fonts-cjk')
source=("${pkgname}::git+${url}.git")
sha256sums=('SKIP')
options=(!lto)

pkgver() {
	cd "${srcdir}/${pkgname}"
	printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
	cd "${srcdir}/${pkgname}"
	cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
	cd "${srcdir}/${pkgname}"
	export CARGO_TARGET_DIR=target
	# makepkg's RUSTFLAGS override .cargo/config.toml, so select mold here too.
	export RUSTFLAGS="${RUSTFLAGS} -C link-arg=-fuse-ld=mold"
	export QUOTE_TEXT_FONT_PATH=/usr/share/fonts/noto-cjk/NotoSansCJK-Black.ttc
	export QUOTE_USERNAME_FONT_PATH=/usr/share/fonts/noto-cjk/NotoSansCJK-Light.ttc
	export CARD_REGULAR_FONT_PATH=/usr/share/fonts/noto-cjk/NotoSansCJK-Regular.ttc
	cargo build --frozen --release --all-features --bin tgbot
}

package() {
	cd "${srcdir}/${pkgname}"
	install -Dm 755 target/release/tgbot "${pkgdir}/usr/lib/tg-maid/tgbot"
}
